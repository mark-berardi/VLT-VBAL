    <LoopInitiator loopType="TrialHandler" name="trials_Intro2">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'IntroText': 'During the lectures there will be background noise. This noise will be loud but not harmful. Please ensure you are speaking such that you can be understood through the noise. ', 'IntroWav': 'Intro2A.wav'}, {'IntroText': 'We will also have you rate your vocal effort associated with the lecture in the noise. ', 'IntroWav': 'Intro2B.wav'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="Intro2.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_Intro2" valType="code"/>
