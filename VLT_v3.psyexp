      <CodeComponent name="noise_cog_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="nback_data = pd.read_excel('1back_trial_sequence.xlsx')&amp;#10;nback_images = nback_data['ImageFile'].tolist()&amp;#10;nback_Target = nback_data['IsTarget'].tolist()&amp;#10;nback_Noise = nback_data['Noise'].tolist()&amp;#10;&amp;#10;feedback_given = [False] * len(nback_images)&amp;#10;space_pressed = [False] * len(nback_images)&amp;#10;&amp;#10;&amp;#10;current_trial = 0&amp;#10;trial_timer = core.Clock()&amp;#10;nb_routine_start_time = None&amp;#10;nb_noise_timer = core.Clock()&amp;#10;&amp;#10;stimulus_duration = .5&amp;#10;isi_duration = 2.5&amp;#10;total_trial_duration = stimulus_duration + isi_duration&amp;#10;&amp;#10;correct = 0&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="nback_data = pd.read_excel(&quot;1back_trial_sequence.xlsx&quot;);&amp;#10;nback_images = nback_data[&quot;ImageFile&quot;].tolist();&amp;#10;nback_Target = nback_data[&quot;IsTarget&quot;].tolist();&amp;#10;nback_Noise = nback_data[&quot;Noise&quot;].tolist();&amp;#10;feedback_given = ([false] * nback_images.length);&amp;#10;space_pressed = ([false] * nback_images.length);&amp;#10;current_trial = 0;&amp;#10;trial_timer = new util.Clock();&amp;#10;nb_routine_start_time = null;&amp;#10;nb_noise_timer = new util.Clock();&amp;#10;stimulus_duration = 0.5;&amp;#10;isi_duration = 2.5;&amp;#10;total_trial_duration = (stimulus_duration + isi_duration);&amp;#10;correct = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((nb_routine_start_time === null)) {&amp;#10;    nb_routine_start_time = nb_noise_timer.getTime();&amp;#10;    sd.play(NLdata, {&quot;samplerate&quot;: NLfs, &quot;loop&quot;: true});&amp;#10;    current_noise = &quot;Low&quot;;&amp;#10;}&amp;#10;trial_timer.reset();&amp;#10;if ((current_trial &lt;= nback_images.length)) {&amp;#10;    nb_img = (&quot;./NBack/&quot; + nback_images[current_trial]);&amp;#10;} else {&amp;#10;    current_trial = 0;&amp;#10;    nb_img = (&quot;./NBack/&quot; + nback_images[current_trial]);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if nb_routine_start_time is None:&amp;#10;    nb_routine_start_time = nb_noise_timer.getTime()&amp;#10;    &amp;#10;    sd.play(NLdata, samplerate=NLfs, loop=True)&amp;#10;    current_noise = 'Low'&amp;#10;&amp;#10;trial_timer.reset()&amp;#10;&amp;#10;if current_trial &lt;= len(nback_images):&amp;#10;    nb_img = './NBack/' + nback_images[current_trial]&amp;#10;else:&amp;#10;    current_trial = 0&amp;#10;    nb_img = './NBack/' + nback_images[current_trial]" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if nback_key_resp.status == STARTED and not waitOnFlip:&amp;#10;    theseKeys = nback_key_resp.getKeys(keyList=['space'], ignoreKeys=[&quot;escape&quot;], waitRelease=False)&amp;#10;    _nback_key_resp_allKeys.extend(theseKeys)&amp;#10;    if len(_nback_key_resp_allKeys):&amp;#10;        nback_key_resp.keys = _nback_key_resp_allKeys[-1].name  # just the last key pressed&amp;#10;&amp;#10;# Your existing timing code&amp;#10;trial_time = trial_timer.getTime()&amp;#10;if trial_time &lt; stimulus_duration:&amp;#10;    nb_img = './NBack/' + nback_images[current_trial]&amp;#10;else:&amp;#10;    nb_img = './NBack/blank.png'&amp;#10;&amp;#10;# Check if spacebar was pressed during this trial and give immediate feedback&amp;#10;if nback_key_resp.keys and not space_pressed[current_trial]:&amp;#10;    space_pressed[current_trial] = True&amp;#10;   &amp;#10;    if nback_Target[current_trial] == 1:&amp;#10;        match_color = 'green'  # Correct hit - show immediately&amp;#10;    else:&amp;#10;        match_color = 'red'  # False alarm - show immediately&amp;#10;&amp;#10;# Check for missed target after stimulus ends&amp;#10;if trial_time &gt;= (total_trial_duration - stimulus_duration) and not feedback_given[current_trial]:&amp;#10;    if not space_pressed[current_trial] and nback_Target[current_trial] == 1:&amp;#10;        match_color = 'red'  # Missed target - show for remainder of trial&amp;#10;   &amp;#10;    feedback_given[current_trial] = True&amp;#10;&amp;#10;# Your existing trial advancement code&amp;#10;if trial_time &gt;= total_trial_duration:&amp;#10;    # Reset everything for next trial BEFORE incrementing&amp;#10;    match_color = 'gray'&amp;#10;    nback_key_resp.keys = None&amp;#10;    nback_key_resp.rt = None&amp;#10;    _nback_key_resp_allKeys = []&amp;#10;   &amp;#10;    current_trial += 1&amp;#10;   &amp;#10;    if current_trial &gt;= len(nback_images):&amp;#10;        sd.stop()&amp;#10;        continueRoutine = False&amp;#10;        noise_cog_trials.finished = True&amp;#10;    else:&amp;#10;        trial_timer.reset()&amp;#10;        correct = 0&amp;#10;&amp;#10;        if nback_Noise[current_trial] == 'Low':&amp;#10;            sd.play(NLdata, samplerate=NLfs, loop=True)&amp;#10;        elif nback_Noise[current_trial] == 'High':&amp;#10;            sd.play(NHdata, samplerate=NHfs, loop=True)" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (((nback_key_resp.status === PsychoJS.Status.STARTED) &amp;&amp; (! waitOnFlip))) {&amp;#10;    theseKeys = nback_key_resp.getKeys({&quot;keyList&quot;: [&quot;space&quot;], &quot;ignoreKeys&quot;: [&quot;escape&quot;], &quot;waitRelease&quot;: false});&amp;#10;    _nback_key_resp_allKeys.concat(theseKeys);&amp;#10;    if (_nback_key_resp_allKeys.length) {&amp;#10;        nback_key_resp.keys = _nback_key_resp_allKeys.slice((- 1))[0].name;&amp;#10;    }&amp;#10;}&amp;#10;trial_time = trial_timer.getTime();&amp;#10;if ((trial_time &lt; stimulus_duration)) {&amp;#10;    nb_img = (&quot;./NBack/&quot; + nback_images[current_trial]);&amp;#10;} else {&amp;#10;    nb_img = &quot;./NBack/blank.png&quot;;&amp;#10;}&amp;#10;if ((nback_key_resp.keys &amp;&amp; (! space_pressed[current_trial]))) {&amp;#10;    space_pressed[current_trial] = true;&amp;#10;    if ((nback_Target[current_trial] === 1)) {&amp;#10;        match_color = &quot;green&quot;;&amp;#10;    } else {&amp;#10;        match_color = &quot;red&quot;;&amp;#10;    }&amp;#10;}&amp;#10;if (((trial_time &gt;= (total_trial_duration - stimulus_duration)) &amp;&amp; (! feedback_given[current_trial]))) {&amp;#10;    if (((! space_pressed[current_trial]) &amp;&amp; (nback_Target[current_trial] === 1))) {&amp;#10;        match_color = &quot;red&quot;;&amp;#10;    }&amp;#10;    feedback_given[current_trial] = true;&amp;#10;}&amp;#10;if ((trial_time &gt;= total_trial_duration)) {&amp;#10;    match_color = &quot;gray&quot;;&amp;#10;    nback_key_resp.keys = null;&amp;#10;    nback_key_resp.rt = null;&amp;#10;    _nback_key_resp_allKeys = [];&amp;#10;    current_trial += 1;&amp;#10;    if ((current_trial &gt;= nback_images.length)) {&amp;#10;        sd.stop();&amp;#10;        continueRoutine = false;&amp;#10;        noise_cog_trials.finished = true;&amp;#10;    } else {&amp;#10;        trial_timer.reset();&amp;#10;        correct = 0;&amp;#10;        if ((nback_Noise[current_trial] === &quot;Low&quot;)) {&amp;#10;            sd.play(NLdata, {&quot;samplerate&quot;: NLfs, &quot;loop&quot;: true});&amp;#10;        } else {&amp;#10;            if ((nback_Noise[current_trial] === &quot;High&quot;)) {&amp;#10;                sd.play(NHdata, {&quot;samplerate&quot;: NHfs, &quot;loop&quot;: true});&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="#sd.stop()" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="noise_cog_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
