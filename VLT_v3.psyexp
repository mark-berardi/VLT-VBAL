        <Param val="# Reset timing variables&amp;#10;nb_routine_start_time = None&amp;#10;trial_timer.reset()&amp;#10;&amp;#10;# Reset trial tracking&amp;#10;current_trial = 0&amp;#10;current_noise = None&amp;#10;&amp;#10;# Reset keyboard response variables MORE THOROUGHLY&amp;#10;nback_key_resp.keys = None&amp;#10;nback_key_resp.rt = None&amp;#10;nback_key_resp.status = NOT_STARTED  # This is important!&amp;#10;_nback_key_resp_allKeys = []&amp;#10;_nback_key_resp_allKeys.clear()  # Extra clearing&amp;#10;&amp;#10;# Reset feedback tracking&amp;#10;space_pressed = [False] * len(nback_images)&amp;#10;feedback_given = [False] * len(nback_images)&amp;#10;&amp;#10;# FORCE reset visual feedback&amp;#10;match_color = 'gray'&amp;#10;&amp;#10;# If you have a circle component, you may need to explicitly set it:&amp;#10;# nback_circle.fillColor = 'gray'  # uncomment and use your actual component name&amp;#10;# nback_circle.lineColor = 'gray'&amp;#10;&amp;#10;# Reset performance tracking&amp;#10;correct = 0&amp;#10;&amp;#10;# Stop any playing audio&amp;#10;sd.stop()&amp;#10;&amp;#10;# Reset image path&amp;#10;nb_img = './NBack/blank.png'" valType="extendedCode" updates="constant" name="End Routine"/>
