        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((ProgressBarTF === 1)) {&amp;#10;    BarOpac = 1;&amp;#10;    RunBar = true;&amp;#10;} else {&amp;#10;    BarOpac = (- 1);&amp;#10;    RunBar = false;&amp;#10;}&amp;#10;trial_filename = (&quot;./Sounds/&quot; + MapIntroWav);&amp;#10;[trialdata, trialfs] = sf.read(trial_filename, {&quot;dtype&quot;: &quot;float32&quot;});&amp;#10;sd.play(trialdata, {&quot;samplerate&quot;: trialfs, &quot;device&quot;: speakersDev});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if ProgressBarTF == 1:&amp;#10;    BarOpac = 1&amp;#10;    RunBar = True&amp;#10;else:&amp;#10;    BarOpac = -1&amp;#10;    RunBar = False&amp;#10;&amp;#10;trial_filename = './Sounds/'+MapIntroWav&amp;#10;trialdata, trialfs = sf.read(trial_filename, dtype='float32')  &amp;#10;&amp;#10;sd.play(trialdata, samplerate=trialfs, device=speakersDev)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if RunBar and t&gt;0.5:&amp;#10;    BarProgress = (t-0.5)/30&amp;#10;&amp;#10;playing = sd.get_stream().active&amp;#10;&amp;#10;if playing:&amp;#10;    CTC_Opac = -1&amp;#10;elif not playing:&amp;#10;    CTC_Opac = 1" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((RunBar &amp;&amp; (t &gt; 0.5))) {&amp;#10;    BarProgress = ((t - 0.5) / 30);&amp;#10;}&amp;#10;playing = sd.get_stream().active;&amp;#10;if (playing) {&amp;#10;    CTC_Opac = (- 1);&amp;#10;} else {&amp;#10;    if ((! playing)) {&amp;#10;        CTC_Opac = 1;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
