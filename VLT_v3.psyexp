      <CodeComponent name="code_Vowel" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="SVID = 0" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="SVID = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((SVID &lt; 1)) {&amp;#10;    read_filename = &quot;./Sounds/vowel.wav&quot;;&amp;#10;    [readdata, readfs] = sf.read(read_filename, {&quot;dtype&quot;: &quot;float32&quot;});&amp;#10;} else {&amp;#10;    read_filename = &quot;./Sounds/blank.wav&quot;;&amp;#10;    [readdata, readfs] = sf.read(read_filename, {&quot;dtype&quot;: &quot;float32&quot;});&amp;#10;}&amp;#10;t1 = ((time.time() - timeStart) + (readdata.length / readfs));&amp;#10;sd.play(readdata, {&quot;samplerate&quot;: readfs});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if SVID &lt; 1:&amp;#10;    read_filename = './Sounds/vowel.wav'&amp;#10;    readdata, readfs = sf.read(read_filename, dtype='float32')&amp;#10;else:&amp;#10;    read_filename = './Sounds/blank.wav'&amp;#10;    readdata, readfs = sf.read(read_filename, dtype='float32')&amp;#10;&amp;#10;&amp;#10;t1 = time.time()-timeStart+len(readdata)/readfs&amp;#10;&amp;#10;sd.play(readdata, samplerate=readfs)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="playing = sd.get_stream().active&amp;#10;&amp;#10;if playing:&amp;#10;    tbar = 0&amp;#10;    tstart = t&amp;#10;elif not playing:&amp;#10;    tbar = (t-tstart)/3.5&amp;#10;&amp;#10;if tbar &lt; 1:&amp;#10;    CTC_Opac = -1&amp;#10;elif tbar &gt;= 1:&amp;#10;    CTC_Opac = 1" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="playing = sd.get_stream().active;&amp;#10;if (playing) {&amp;#10;    tbar = 0;&amp;#10;    tstart = t;&amp;#10;} else {&amp;#10;    if ((! playing)) {&amp;#10;        tbar = ((t - tstart) / 3.5);&amp;#10;    }&amp;#10;}&amp;#10;if ((tbar &lt; 1)) {&amp;#10;    CTC_Opac = (- 1);&amp;#10;} else {&amp;#10;    if ((tbar &gt;= 1)) {&amp;#10;        CTC_Opac = 1;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if SVID &lt; 1:&amp;#10;    sd.stop()&amp;#10;&amp;#10;with open(filename+'_segtimes.csv', mode='r') as file:&amp;#10;    reader = csv.reader(file)&amp;#10;    segData = [row for row in reader]&amp;#10;t2 = time.time()-timeStart&amp;#10;&amp;#10;SVID += 1&amp;#10;new_row = ['SV_'+str(SVID), t1, t2]&amp;#10;segData.append(new_row)&amp;#10;&amp;#10;# Save the modified data back to the CSV file&amp;#10;with open(filename+'_segtimes.csv', mode='w', newline='') as file:&amp;#10;    writer = csv.writer(file)&amp;#10;    writer.writerows(segData)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_Vowel" valType="code" updates="None" name="name"/>
      </CodeComponent>
