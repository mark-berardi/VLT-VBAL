      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'IntroText': 'Welcome to the study. Please click anywhere to continue.', 'IntroWav': 'Intro1A.wav'}, {'IntroText': 'In this study, you will present lectures from a 5th grade science classroom. You will be given presentation slides. Please read all of the words on the slides so that information can be understood.', 'IntroWav': 'Intro1B.wav'}, {'IntroText': 'First, here is an example.', 'IntroWav': 'Intro1C.wav'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="Intro1.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_Intro1" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
