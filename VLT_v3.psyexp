        <Param val="(&quot;0    Nothing at all&quot;, &quot;1    &quot;, &quot;2    Minimal&quot;, &quot;3    Extremely weak&quot;, &quot;5    &quot;, &quot;6    Very weak&quot;, &quot;7    &quot;, &quot;10    &quot;, &quot;13    Weak         Light&quot;, &quot;15    &quot;, &quot;20    &quot;, &quot;25    Moderate&quot;, &quot;30    &quot;, &quot;35    &quot;, &quot;37    Somewhat strong&quot;, &quot;40    &quot;, &quot;45    &quot;, &quot;50    Strong        Heavy&quot;, &quot;55    &quot;, &quot;60    &quot;, &quot;65    &quot;, &quot;70    Very Strong&quot;, &quot;75    &quot;, &quot;80    &quot;, &quot;85    &quot;, &quot;90    Extremely strong&quot;, &quot;95    &quot;, &quot;100    Max     almost maximal&quot;, &quot;110    &quot;, &quot;120    Absolute maxmimum&quot;)" valType="list" updates="constant" name="labels"/>
