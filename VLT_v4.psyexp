        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="playing = sd.get_stream().active&amp;#10;&amp;#10;if playing:&amp;#10;    #CTC_Opac = -1&amp;#10;    pass&amp;#10;elif not playing:&amp;#10;    #CTC_Opac = 1&amp;#10;    time.sleep(0.25)&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
