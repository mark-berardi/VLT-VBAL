      <CodeComponent name="code_Map" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# See Noise Test for preloading of sound files&amp;#10;&amp;#10;MapTrial = 0&amp;#10;TrialID = ''" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="MapTrial = 0;&amp;#10;TrialID = &quot;&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="playing = sd.get_stream().active;&amp;#10;if (playing) {&amp;#10;    sd.stop();&amp;#10;}&amp;#10;BarProgress = 0;&amp;#10;t1 = (time.time() - timeStart);&amp;#10;MapTrial += 1;&amp;#10;if (((NoiseType === 1) &amp;&amp; (SpeakerType === 1))) {&amp;#10;    sd.play((0.9 * noisedata), {&quot;samplerate&quot;: noisefs, &quot;device&quot;: speakersDev});&amp;#10;    TrialID = &quot;SpeakerNoise&quot;;&amp;#10;} else {&amp;#10;    if (((NoiseType === 2) &amp;&amp; (SpeakerType === 1))) {&amp;#10;        sd.play(babbledata, {&quot;samplerate&quot;: babblefs, &quot;device&quot;: speakersDev});&amp;#10;        TrialID = &quot;SpeakerBabble&quot;;&amp;#10;    } else {&amp;#10;        if (((NoiseType === 1) &amp;&amp; (SpeakerType === 2))) {&amp;#10;            sd.play((0.9 * noisedata), {&quot;samplerate&quot;: noisefs, &quot;device&quot;: headphonesDev});&amp;#10;            TrialID = &quot;HeadphoneNoise&quot;;&amp;#10;        } else {&amp;#10;            if (((NoiseType === 2) &amp;&amp; (SpeakerType === 2))) {&amp;#10;                sd.play(babbledata, {&quot;samplerate&quot;: babblefs, &quot;device&quot;: headphonesDev});&amp;#10;                TrialID = &quot;HeadphoneBabble&quot;;&amp;#10;            } else {&amp;#10;                if ((NoiseType === 3)) {&amp;#10;                    TrialID = &quot;NoNoise&quot;;&amp;#10;                }&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;buttons = [];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="playing = sd.get_stream().active&amp;#10;&amp;#10;if playing:&amp;#10;    sd.stop()&amp;#10;&amp;#10;BarProgress = 0&amp;#10;&amp;#10;t1 = time.time()-timeStart&amp;#10;&amp;#10;MapTrial += 1&amp;#10;&amp;#10;if NoiseType == 1 and SpeakerType == 1:&amp;#10;    sd.play(0.9*noisedata, samplerate=noisefs, device=speakersDev)&amp;#10;    TrialID = 'SpeakerNoise'&amp;#10;elif NoiseType == 2 and SpeakerType == 1:&amp;#10;    sd.play(babbledata, samplerate=babblefs, device=speakersDev)&amp;#10;    TrialID = 'SpeakerBabble'&amp;#10;elif NoiseType == 1 and SpeakerType == 2:&amp;#10;    sd.play(0.9*noisedata, samplerate=noisefs, device=headphonesDev)&amp;#10;    TrialID = 'HeadphoneNoise'&amp;#10;elif NoiseType == 2 and SpeakerType == 2:&amp;#10;    sd.play(babbledata, samplerate=babblefs, device=headphonesDev)&amp;#10;    TrialID = 'HeadphoneBabble'&amp;#10;elif NoiseType == 3:&amp;#10;    TrialID = 'NoNoise'&amp;#10;&amp;#10;buttons = []&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="#sd.stop()&amp;#10;&amp;#10;with open(filename+'_segtimes.csv', mode='r') as file:&amp;#10;    reader = csv.reader(file)&amp;#10;    segData = [row for row in reader]&amp;#10;t2 = time.time()-timeStart&amp;#10;&amp;#10;new_row = [str(MapTrial)+'_'+TrialID, t1, t2]&amp;#10;segData.append(new_row)&amp;#10;&amp;#10;# Save the modified data back to the CSV file&amp;#10;with open(filename+'_segtimes.csv', mode='w', newline='') as file:&amp;#10;    writer = csv.writer(file)&amp;#10;    writer.writerows(segData)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
