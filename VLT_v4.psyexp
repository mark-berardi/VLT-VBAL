      <CodeComponent name="code_Cal" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="Cal1 = False&amp;#10;Cal2 = False" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="Cal1 = false;&amp;#10;Cal2 = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if Done1 and not Done2:&amp;#10;    StepText = 'Step 2: At 50 cm, have the participant say a strong &quot;ah&quot; for 5 seconds.'&amp;#10;&amp;#10;if Done1 and Done2:&amp;#10;    StepText = 'Press Done!'&amp;#10;&amp;#10;if Cal1:&amp;#10;    dt = (time.time()-timeStart)-cal1t1&amp;#10;    prog_Cal_Val = dt/3&amp;#10;&amp;#10;if Cal1 and (time.time()-timeStart)-cal1t1 &gt; 3:&amp;#10;    Cal1 = False&amp;#10;    cal1t2 = time.time()-timeStart&amp;#10;    &amp;#10;    with open(filename+'_segtimes.csv', mode='r') as file:&amp;#10;        reader = csv.reader(file)&amp;#10;        segData = [row for row in reader]&amp;#10;&amp;#10;    new_row = ['Cal1', cal1t1, cal1t2]&amp;#10;    segData.append(new_row)&amp;#10;&amp;#10;    # Save the modified data back to the CSV file&amp;#10;    with open(filename+'_segtimes.csv', mode='w', newline='') as file:&amp;#10;        writer = csv.writer(file)&amp;#10;        writer.writerows(segData)&amp;#10;        &amp;#10;    Done1 = True&amp;#10;&amp;#10;if Cal2:&amp;#10;    dt = (time.time()-timeStart)-cal2t1&amp;#10;    prog_Cal_Val = dt/3&amp;#10;&amp;#10;if Cal2 and (time.time()-timeStart)-cal2t1 &gt; 3:&amp;#10;    Cal2 = False&amp;#10;    cal2t2 = time.time()-timeStart&amp;#10;    &amp;#10;    with open(filename+'_segtimes.csv', mode='r') as file:&amp;#10;        reader = csv.reader(file)&amp;#10;        segData = [row for row in reader]&amp;#10;&amp;#10;    new_row = ['Cal2', cal2t1, cal2t2]&amp;#10;    segData.append(new_row)&amp;#10;&amp;#10;    # Save the modified data back to the CSV file&amp;#10;    with open(filename+'_segtimes.csv', mode='w', newline='') as file:&amp;#10;        writer = csv.writer(file)&amp;#10;        writer.writerows(segData)&amp;#10;        &amp;#10;    Done2 = True" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_Cal" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="SpeechTask">
      <RoutineSettingsComponent name="SpeechTask" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="SpeechTask" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="code_SpeechTask" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((Task === &quot;Reading&quot;)) {&amp;#10;    text_SpeechTask_mid.alignText = &quot;left&quot;;&amp;#10;    text_SpeechTask_mid.color = [(- 1), (- 1), (- 1)];&amp;#10;    SpeechTextHigh = &quot;&quot;;&amp;#10;    SpeechTextLow = &quot;&quot;;&amp;#10;    SpeechTextMid = SpeechText;&amp;#10;} else {&amp;#10;    if (((Task === &quot;Vowel&quot;) || &quot;RFF&quot;)) {&amp;#10;        SpeechTextHigh = SpeechText;&amp;#10;        SpeechTextLow = SpeechText;&amp;#10;        SpeechTextMid = SpeechText;&amp;#10;        text_SpeechTask_mid.alignText = &quot;center&quot;;&amp;#10;        if ((RFF_rep === 1)) {&amp;#10;            text_SpeechTask_high.color = [(- 1), (- 1), (- 1)];&amp;#10;            text_SpeechTask_mid.color = [0.8, 0.8, 0.8];&amp;#10;            text_SpeechTask_low.color = [0.8, 0.8, 0.8];&amp;#10;        } else {&amp;#10;            if ((RFF_rep === 2)) {&amp;#10;                text_SpeechTask_high.color = [0.8, 0.8, 0.8];&amp;#10;                text_SpeechTask_mid.color = [(- 1), (- 1), (- 1)];&amp;#10;                text_SpeechTask_low.color = [0.8, 0.8, 0.8];&amp;#10;            } else {&amp;#10;                if ((RFF_rep === 3)) {&amp;#10;                    text_SpeechTask_high.color = [0.8, 0.8, 0.8];&amp;#10;                    text_SpeechTask_mid.color = [0.8, 0.8, 0.8];&amp;#10;                    text_SpeechTask_low.color = [(- 1), (- 1), (- 1)];&amp;#10;                }&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;isStop = 0;&amp;#10;t1 = (time.time() - timeStart);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if Task == &quot;Reading&quot;:&amp;#10;    text_SpeechTask_mid.alignText='left'&amp;#10;    text_SpeechTask_mid.color = (-1,-1,-1)&amp;#10;    SpeechTextHigh = ''&amp;#10;    SpeechTextLow = ''&amp;#10;    SpeechTextMid = SpeechText&amp;#10;&amp;#10;elif Task == &quot;Vowel&quot; or &quot;RFF&quot;:&amp;#10;    SpeechTextHigh = SpeechText&amp;#10;    SpeechTextLow = SpeechText&amp;#10;    SpeechTextMid = SpeechText&amp;#10;    text_SpeechTask_mid.alignText='center'&amp;#10;    if RFF_rep == 1:&amp;#10;        text_SpeechTask_high.color = (-1,-1,-1)&amp;#10;        text_SpeechTask_mid.color = (.8,.8,.8)&amp;#10;        text_SpeechTask_low.color = (.8,.8,.8)&amp;#10;#        text_ClickToContinue_4.text = &quot;&quot;&amp;#10;    elif RFF_rep == 2:&amp;#10;        text_SpeechTask_high.color = (.8,.8,.8)&amp;#10;        text_SpeechTask_mid.color = (-1,-1,-1)&amp;#10;        text_SpeechTask_low.color = (.8,.8,.8)&amp;#10;#        text_ClickToContinue_4.text = &quot;&quot;&amp;#10;    elif RFF_rep == 3:&amp;#10;        text_SpeechTask_high.color = (.8,.8,.8)&amp;#10;        text_SpeechTask_mid.color = (.8,.8,.8)&amp;#10;        text_SpeechTask_low.color = (-1,-1,-1)&amp;#10;#        text_ClickToContinue_4.text = &quot;&quot;&amp;#10;&amp;#10;isStop = 0&amp;#10;#mic.start()&amp;#10;t1 = time.time()-timeStart" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="#mic.poll()&amp;#10;&amp;#10;if key_resp_SpeechTask.status == STARTED and not waitOnFlip:&amp;#10;    theseKeys = key_resp_SpeechTask.getKeys(keyList=['y','n','left','right','space','backspace'], waitRelease=False)&amp;#10;    if 'backspace' in theseKeys or 'left' in theseKeys:&amp;#10;        if RFF_rep == 1:&amp;#10;            text_SpeechTask_high.color = (-1*text_SpeechTask_high.color[0],-1,-1)&amp;#10;            text_SpeechTask_mid.color = (.8,.8,.8)&amp;#10;            text_SpeechTask_low.color = (.8,.8,.8)&amp;#10;    #        text_ClickToContinue_4.text = &quot;&quot;&amp;#10;        elif RFF_rep == 2:&amp;#10;            text_SpeechTask_high.color = (.8,.8,.8)&amp;#10;            text_SpeechTask_mid.color = (-1*text_SpeechTask_mid.color[0],-1,-1)&amp;#10;            text_SpeechTask_low.color = (.8,.8,.8)&amp;#10;    #        text_ClickToContinue_4.text = &quot;&quot;&amp;#10;        elif RFF_rep == 3:&amp;#10;            text_SpeechTask_high.color = (.8,.8,.8)&amp;#10;            text_SpeechTask_mid.color = (.8,.8,.8)&amp;#10;            text_SpeechTask_low.color = (-1*text_SpeechTask_low.color[0],-1,-1)&amp;#10;        else:&amp;#10;            text_SpeechTask_mid.color = (-1*text_SpeechTask_mid.color[0],-1,-1)&amp;#10;    else:&amp;#10;        if prepost == 'pre':&amp;#10;            speech_trials_pre.finished = True&amp;#10;        if prepost == 'post':&amp;#10;            speech_trials_post.finished = True&amp;#10;        _key_resp_SpeechTask_allKeys.extend(theseKeys)&amp;#10;        if len(_key_resp_SpeechTask_allKeys):&amp;#10;            key_resp_SpeechTask.keys = _key_resp_SpeechTask_allKeys[-1].name  # just the last key pressed&amp;#10;            key_resp_SpeechTask.rt = _key_resp_SpeechTask_allKeys[-1].rt&amp;#10;            # a response ends the routine&amp;#10;#            if isRFF &lt; 2:&amp;#10;#                continueRoutine = False&amp;#10;            if isStop == 1:&amp;#10;                time.sleep(1)&amp;#10;                continueRoutine = False&amp;#10;            else:&amp;#10;                time.sleep(5)&amp;#10;                text_SpeechTask_mid.alignText='center'&amp;#10;                text_SpeechTask_mid.color = (-1,-1,-1)&amp;#10;                SpeechTextHigh = ''&amp;#10;                SpeechTextLow = ''&amp;#10;                SpeechTextMid = 'STOP'&amp;#10;                isStop = 1&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;if (((key_resp_SpeechTask.status === PsychoJS.Status.STARTED) &amp;&amp; (! waitOnFlip))) {&amp;#10;    theseKeys = key_resp_SpeechTask.getKeys({&quot;keyList&quot;: [&quot;y&quot;, &quot;n&quot;, &quot;left&quot;, &quot;right&quot;, &quot;space&quot;, &quot;backspace&quot;], &quot;waitRelease&quot;: false});&amp;#10;    if ((_pj.in_es6(&quot;backspace&quot;, theseKeys) || _pj.in_es6(&quot;left&quot;, theseKeys))) {&amp;#10;        if ((RFF_rep === 1)) {&amp;#10;            text_SpeechTask_high.color = [((- 1) * text_SpeechTask_high.color[0]), (- 1), (- 1)];&amp;#10;            text_SpeechTask_mid.color = [0.8, 0.8, 0.8];&amp;#10;            text_SpeechTask_low.color = [0.8, 0.8, 0.8];&amp;#10;        } else {&amp;#10;            if ((RFF_rep === 2)) {&amp;#10;                text_SpeechTask_high.color = [0.8, 0.8, 0.8];&amp;#10;                text_SpeechTask_mid.color = [((- 1) * text_SpeechTask_mid.color[0]), (- 1), (- 1)];&amp;#10;                text_SpeechTask_low.color = [0.8, 0.8, 0.8];&amp;#10;            } else {&amp;#10;                if ((RFF_rep === 3)) {&amp;#10;                    text_SpeechTask_high.color = [0.8, 0.8, 0.8];&amp;#10;                    text_SpeechTask_mid.color = [0.8, 0.8, 0.8];&amp;#10;                    text_SpeechTask_low.color = [((- 1) * text_SpeechTask_low.color[0]), (- 1), (- 1)];&amp;#10;                } else {&amp;#10;                    text_SpeechTask_mid.color = [((- 1) * text_SpeechTask_mid.color[0]), (- 1), (- 1)];&amp;#10;                }&amp;#10;            }&amp;#10;        }&amp;#10;    } else {&amp;#10;        if ((prepost === &quot;pre&quot;)) {&amp;#10;            speech_trials_pre.finished = true;&amp;#10;        }&amp;#10;        if ((prepost === &quot;post&quot;)) {&amp;#10;            speech_trials_post.finished = true;&amp;#10;        }&amp;#10;        _key_resp_SpeechTask_allKeys.concat(theseKeys);&amp;#10;        if (_key_resp_SpeechTask_allKeys.length) {&amp;#10;            key_resp_SpeechTask.keys = _key_resp_SpeechTask_allKeys.slice((- 1))[0].name;&amp;#10;            key_resp_SpeechTask.rt = _key_resp_SpeechTask_allKeys.slice((- 1))[0].rt;&amp;#10;            if ((isStop === 1)) {&amp;#10;                time.sleep(1);&amp;#10;                continueRoutine = false;&amp;#10;            } else {&amp;#10;                time.sleep(5);&amp;#10;                text_SpeechTask_mid.alignText = &quot;center&quot;;&amp;#10;                text_SpeechTask_mid.color = [(- 1), (- 1), (- 1)];&amp;#10;                SpeechTextHigh = &quot;&quot;;&amp;#10;                SpeechTextLow = &quot;&quot;;&amp;#10;                SpeechTextMid = &quot;STOP&quot;;&amp;#10;                isStop = 1;&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="t2 = time.time()-timeStart&amp;#10;&amp;#10;#mic.stop()&amp;#10;#audioClip = mic.getRecording()&amp;#10;&amp;#10;if Task == &quot;Vowel&quot; or &quot;RFF&quot;:&amp;#10;    trialName = WavName+'_'+str(RFF_rep)+'_'+prepost  # save the recorded audio as a 'wav' file&amp;#10;else:&amp;#10;    trialName = WavName+'_'+prepost  # save the recorded audio as a 'wav' file&amp;#10;&amp;#10;# Load the CSV file&amp;#10;with open(filename+'_segtimes.csv', mode='r') as file:&amp;#10;    reader = csv.reader(file)&amp;#10;    segData = [row for row in reader]&amp;#10;&amp;#10;new_row = [trialName, t1, t2]&amp;#10;segData.append(new_row)&amp;#10;&amp;#10;# Save the modified data back to the CSV file&amp;#10;with open(filename+'_segtimes.csv', mode='w', newline='') as file:&amp;#10;    writer = csv.writer(file)&amp;#10;    writer.writerows(segData)&amp;#10;&amp;#10;theseKeys = key_resp_SpeechTask.getKeys(keyList=['y','n','left','right','space','backspace'], waitRelease=False)&amp;#10;if 'backspace' in theseKeys or 'left' in theseKeys:&amp;#10;    RepeatSS = True&amp;#10;    print('REPEAT')&amp;#10;else:&amp;#10;    if prepost == 'pre':&amp;#10;        speech_trials_pre.finished = True&amp;#10;    if prepost == 'post':&amp;#10;        speech_trials_post.finished = True" valType="extendedCode" updates="constant" name="End Routine"/>
