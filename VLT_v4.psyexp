      <CodeComponent name="noise_cog_code_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="nback_data_2 = pd.read_excel('1back_trial_sequence_short.xlsx')&amp;#10;nback_images_2 = nback_data_2['ImageFile'].tolist()&amp;#10;nback_Target_2 = nback_data_2['IsTarget'].tolist()&amp;#10;&amp;#10;trial_timer_2 = core.Clock()&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="nback_data_2 = pd.read_excel(&quot;1back_trial_sequence_short.xlsx&quot;);&amp;#10;nback_images_2 = nback_data_2[&quot;ImageFile&quot;].tolist();&amp;#10;nback_Target_2 = nback_data_2[&quot;IsTarget&quot;].tolist();&amp;#10;trial_timer_2 = new util.Clock();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((! repeat_flag)) {&amp;#10;    cog_practice_trials.finished = true;&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;trial_timer_2.reset();&amp;#10;feedback_given_2 = ([false] * nback_images_2.length);&amp;#10;space_pressed_2 = ([false] * nback_images_2.length);&amp;#10;current_trial_2 = 0;&amp;#10;nb_routine_start_time_2 = null;&amp;#10;correct_2 = 0;&amp;#10;nb_img_2 = (&quot;./NBack/&quot; + nback_images_2[current_trial_2]);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if not repeat_flag:&amp;#10;    cog_practice_trials.finished = True&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;trial_timer_2.reset()&amp;#10;&amp;#10;feedback_given_2 = [False] * len(nback_images_2)&amp;#10;space_pressed_2 = [False] * len(nback_images_2)&amp;#10;&amp;#10;&amp;#10;current_trial_2 = 0&amp;#10;nb_routine_start_time_2 = None&amp;#10;&amp;#10;correct_2 = 0&amp;#10;&amp;#10;nb_img_2 = './NBack/' + nback_images_2[current_trial_2]&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if nback_key_resp_2.status == STARTED and not waitOnFlip:&amp;#10;    theseKeys = nback_key_resp_2.getKeys(keyList=['space'], ignoreKeys=[&quot;escape&quot;], waitRelease=False)&amp;#10;    _nback_key_resp_2_allKeys.extend(theseKeys)&amp;#10;    if len(_nback_key_resp_2_allKeys):&amp;#10;        nback_key_resp_2.keys = _nback_key_resp_2_allKeys[-1].name  # just the last key pressed&amp;#10;&amp;#10;# Your existing timing code&amp;#10;trial_time_2 = trial_timer_2.getTime()&amp;#10;if trial_time_2 &lt; stimulus_duration:&amp;#10;    nb_img_2 = './NBack/' + nback_images_2[current_trial_2]&amp;#10;else:&amp;#10;    nb_img_2 = './NBack/blank.png'&amp;#10;&amp;#10;# Check if spacebar was pressed during this trial and give immediate feedback&amp;#10;if nback_key_resp_2.keys and not space_pressed_2[current_trial_2]:&amp;#10;    space_pressed_2[current_trial_2] = True&amp;#10;   &amp;#10;    if nback_Target_2[current_trial_2] == 1:&amp;#10;        match_color_2 = 'green'  # Correct hit - show immediately&amp;#10;        Text_cog_practice = 'Match!'&amp;#10;    else:&amp;#10;        match_color_2 = 'red'  # False alarm - show immediately&amp;#10;        Text_cog_practice = 'Incorrect.'&amp;#10;&amp;#10;# Check for missed target after stimulus ends&amp;#10;if trial_time_2 &gt;= (total_trial_duration - stimulus_duration) and not feedback_given_2[current_trial_2]:&amp;#10;    if not space_pressed_2[current_trial_2] and nback_Target_2[current_trial_2] == 1:&amp;#10;        match_color_2 = 'red'  # Missed target - show for remainder of trial&amp;#10;        Text_cog_practice = 'Missed it...'&amp;#10;        &amp;#10;    feedback_given_2[current_trial_2] = True&amp;#10;&amp;#10;# Your existing trial advancement code&amp;#10;if trial_time_2 &gt;= total_trial_duration:&amp;#10;    # Reset everything for next trial BEFORE incrementing&amp;#10;    match_color_2 = 'gray'&amp;#10;    Text_cog_practice = ''&amp;#10;    nback_key_resp_2.keys = None&amp;#10;    nback_key_resp_2.rt = None&amp;#10;    _nback_key_resp_2_allKeys = []&amp;#10;   &amp;#10;    current_trial_2 += 1&amp;#10;   &amp;#10;    if current_trial_2 &gt;= len(nback_images_2):&amp;#10;        continueRoutine = False&amp;#10;    else:&amp;#10;        trial_timer_2.reset()&amp;#10;        correct_2 = 0" valType="extendedCode" updates="constant" name="Each Frame"/>
