        <Param val="trial_filename = &quot;./Sounds/CogIntro.wav&quot;;&amp;#10;[trialdata, trialfs] = sf.read(trial_filename, {&quot;dtype&quot;: &quot;float32&quot;});&amp;#10;sd.play(trialdata, {&quot;samplerate&quot;: trialfs});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
