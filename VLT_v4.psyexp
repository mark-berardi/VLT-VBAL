        <Param val="[trialdata, trialfs] = sf.read(sound_intro_1, {&quot;dtype&quot;: &quot;float32&quot;});&amp;#10;sd.play((Vol * trialdata), {&quot;samplerate&quot;: trialfs});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
