  <Flow>
    <Routine name="Ready"/>
    <Routine name="Calibration"/>
    <Routine name="Ready2"/>
    <LoopInitiator loopType="TrialHandler" name="trials_Intro1">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'IntroText': 'Welcome to the study. Please click anywhere to continue.', 'IntroWav': 'Intro1A.wav'}, {'IntroText': &quot;In this study, you will narrate stories from a children's picture book.&quot;, 'IntroWav': 'Intro1B_pic.wav'}, {'IntroText': 'First, here is an example.', 'IntroWav': 'Intro1C.wav'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="PsychoPy/Intro1_pic.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_Intro1" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="Intro"/>
    <LoopTerminator name="trials_Intro1"/>
    <LoopInitiator loopType="TrialHandler" name="trials_stimintro1">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'picture_image_intro1': 'Pics/Frog01-z.png', 'sound_intro_1': 'Sound/PicIntroA.wav'}, {'picture_image_intro1': 'Pics/Frog02-z.png', 'sound_intro_1': 'Sound/PicIntroB.wav'}, {'picture_image_intro1': 'Pics/Frog03-z.png', 'sound_intro_1': 'Sound/PicIntroC.wav'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="PsychoPy/Pics_Intro1.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_stimintro1" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="StimIntro1"/>
    <LoopTerminator name="trials_stimintro1"/>
    <Routine name="Practice"/>
    <LoopInitiator loopType="TrialHandler" name="trials_stimintro2">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'picture_image_intro2': 'Pics/Frog04-z.png'}, {'picture_image_intro2': 'Pics/Frog05-z.png'}, {'picture_image_intro2': 'Pics/Frog06-z.png'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="PsychoPy/Pics_Intro2.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_stimintro2" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="StimIntro2"/>
    <LoopTerminator name="trials_stimintro2"/>
    <LoopInitiator loopType="TrialHandler" name="trials_Intro2">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'IntroText': 'During the lectures there will be background noise. This noise will be loud but not harmful. Please ensure you are speaking loud enough to be understood through the noise. ', 'IntroWav': 'Intro2A.wav'}, {'IntroText': 'You will rate your vocal effort associated with the lecture in the noise. ', 'IntroWav': 'Intro2B.wav'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="PsychoPy/Intro2.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_Intro2" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="Intro"/>
    <LoopTerminator name="trials_Intro2"/>
    <Routine name="BorgRating_Intro"/>
    <Routine name="BorgRating_Intro_2"/>
    <Routine name="NoiseTest"/>
    <Routine name="BorgRating"/>
    <Routine name="Begin"/>
    <LoopInitiator loopType="TrialHandler" name="pre_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'SpeechIntroText': 'Using your natural voice with comfortable pitch and loudness, read the following text. ', 'SpeechText': 'When the sunlight strikes raindrops in the air, they act as a prism and form a rainbow. The rainbow is a division of white light into many beautiful colors. These take the shape of a long round arch, with its path high above, and its two ends apparently beyond the horizon. There is, according to legend, a boiling pot of gold at one end. People look, but no one ever finds it. When a man looks for something beyond his reach, his friends say he is looking for the pot of gold at the end of the rainbow.', 'IntroSound': 'READ.wav', 'isIntro': 1.0, 'Task': 'Reading', 'RFF_rep': 0, 'WavName': 'rainbow', 'RatingTF': 1}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="PsychoPy/prepost.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="pre_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="SpeechIntro"/>
    <LoopInitiator loopType="TrialHandler" name="speech_trials_pre">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="10" valType="num"/>
      <Param name="name" updates="None" val="speech_trials_pre" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="SpeechTask"/>
    <LoopTerminator name="speech_trials_pre"/>
    <Routine name="BorgRating"/>
    <LoopTerminator name="pre_loop"/>
    <LoopInitiator loopType="TrialHandler" name="trials_noise">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'Noise': 'Babble', 'Level': 'High', 'Duration': 3}, {'Noise': 'Babble', 'Level': 'High', 'Duration': 3}, {'Noise': 'Babble', 'Level': 'High', 'Duration': 3}, {'Noise': 'Babble', 'Level': 'High', 'Duration': 3}, {'Noise': 'Babble', 'Level': 'High', 'Duration': 3}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="PsychoPy/VLT_params.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_noise" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="VLT_init"/>
    <LoopInitiator loopType="TrialHandler" name="VLT_stim">
      <Param name="Selected rows" updates="None" val="$pages" valType="str"/>
      <Param name="conditions" updates="None" val="[{'picture_image': 'Pics/Frog01.png'}, {'picture_image': 'Pics/Frog02.png'}, {'picture_image': 'Pics/Frog03.png'}, {'picture_image': 'Pics/Frog04.png'}, {'picture_image': 'Pics/Frog05.png'}, {'picture_image': 'Pics/Frog06.png'}, {'picture_image': 'Pics/Frog07.png'}, {'picture_image': 'Pics/Frog08.png'}, {'picture_image': 'Pics/Frog09.png'}, {'picture_image': 'Pics/Frog10.png'}, {'picture_image': 'Pics/Frog11.png'}, {'picture_image': 'Pics/Frog12.png'}, {'picture_image': 'Pics/Frog13.png'}, {'picture_image': 'Pics/Frog14.png'}, {'picture_image': 'Pics/Frog15.png'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="PsychoPy/Pics_all.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="99" valType="num"/>
      <Param name="name" updates="None" val="VLT_stim" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="STIMULI"/>
    <LoopTerminator name="VLT_stim"/>
    <Routine name="BorgRating"/>
    <LoopTerminator name="trials_noise"/>
    <LoopInitiator loopType="TrialHandler" name="trials_TLX">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'TLX_Title': 'Mental Demand', 'TLX_Description': 'How much mental and perceptual activity was required (e.g. thinking, deciding, calculating, remembering, looking, searching, etc.)? Was the task easy or demanding, simple or complex, exacting or forgiving?', 'TLX_Label_Num': 1}, {'TLX_Title': 'Physical Demand', 'TLX_Description': ' much physical activity was required (e.g. pushing, pulling, turning, controlling, activating, etc.)? Was the task easy or demanding, slow or brisk, slack or strenuous, restful or laborious?', 'TLX_Label_Num': 1}, {'TLX_Title': 'Temporal Demand', 'TLX_Description': 'How much time pressure did you feel due to the rate or pace at which the tasks or task elements occurred? Was the pace slow and leisurely or rapid and frantic?', 'TLX_Label_Num': 1}, {'TLX_Title': 'Performance', 'TLX_Description': 'How successful do you think you were in accomplishing the goals of the task set by the experimenter (or yourself)? How satisfied were you with your performance in accomplishing these goals?', 'TLX_Label_Num': 2}, {'TLX_Title': 'Effort', 'TLX_Description': 'How hard did you have to work (mentally and physically) to accomplish your level of performance?', 'TLX_Label_Num': 1}, {'TLX_Title': 'Frustration Level', 'TLX_Description': 'How insecure, discouraged, irritated, stressed and annoyed versus secure, gratified, content, relaxed and complacent did you feel during the task?', 'TLX_Label_Num': 1}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="PsychoPy/TLX.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_TLX" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="TLX"/>
    <LoopTerminator name="trials_TLX"/>
    <Routine name="BorgRating"/>
    <Routine name="End"/>
  </Flow>
</PsychoPy2experiment>
