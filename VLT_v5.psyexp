    <LoopInitiator loopType="TrialHandler" name="trials_stimIntro1">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'picture_image_intro1': 'Pics/Frog01-z.png', 'PicText': 'There was a boy who went down to the pond one afternoon to do some fishing, and he brought his dog and his pet frog along with him. He got himself settled on the bank, with his bucket and his little shovel beside him, dropped his line in the water, and sat back to wait for a bite. The dog and the frog sat together just behind him, watching the water along with him.', 'PicWav': 'Sounds/PicIntroA.wav'}, {'picture_image_intro1': 'Pics/Frog02-z.png', 'PicText': &quot;He fished for a while, holding onto his pole and keeping an eye on the bobber. Then all of a sudden the frog hopped off toward the water, and the dog sprang up after it, right over the boy's shoulder. The boy lost his balance and toppled headfirst into the pond, so that only his legs were left sticking up out of the water, while the dog went sailing through the air after the frog.&quot;, 'PicWav': 'Sounds/PicIntroB.wav'}, {'picture_image_intro1': 'Pics/Frog03-z.png', 'PicText': 'When he came back up he was soaking wet and none too pleased. He stood up in the water, threw up his arm, and shouted at the dog for knocking him in. But while he was busy complaining, a turtle came crawling out along the pebbly shore, and it looked as though it had taken his fishing line. The frog just sat there quietly in the water nearby, watching the whole thing happen.', 'PicWav': 'Sounds/PicIntroC.wav'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="PsychoPy/Pics_Intro1.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_stimIntro1" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
