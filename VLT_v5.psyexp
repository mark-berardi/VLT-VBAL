      </VariableComponent>
      <CodeComponent name="code_ready" plugin="None">
        <Param val="import time&amp;#10;import csv&amp;#10;import os&amp;#10;import numpy as np&amp;#10;from datetime import date&amp;#10;import sounddevice as sd&amp;#10;import json&amp;#10;&amp;#10;# Builder does this later at line ~476, but Before Experiment runs at import,&amp;#10;# so relative paths need it now. Idempotent.&amp;#10;os.chdir(os.path.dirname(os.path.abspath(__file__)))&amp;#10;&amp;#10;VLT_SYNC_NONE = '-- none (DEBUG: no sync device on this machine) --'&amp;#10;&amp;#10;&amp;#10;def vlt_output_devices():&amp;#10;    apis = sd.query_hostapis()&amp;#10;    return [(i, d['name'], apis[d['hostapi']]['name'], d['max_output_channels'])&amp;#10;            for i, d in enumerate(sd.query_devices())&amp;#10;            if d['max_output_channels'] &gt; 0]&amp;#10;&amp;#10;&amp;#10;def vlt_find_device(name, hostapi):&amp;#10;    &quot;&quot;&quot;Name + host API -&gt; the index sd.play(device=) wants. Pinning by name&amp;#10;    survives re-enumeration; pinning by index does not. Host API is part of&amp;#10;    the key because on Windows one device appears under MME, WASAPI and&amp;#10;    DirectSound under the same name.&quot;&quot;&quot;&amp;#10;    m = [e for e in vlt_output_devices() if e[1] == name and e[2] == hostapi]&amp;#10;    if not m:&amp;#10;        raise RuntimeError(&amp;#10;            'Audio device not found:\n\n    &quot;%s&quot;  [%s]\n\n'&amp;#10;            'It is not connected, or it has been renamed.\n'&amp;#10;            'Tick reset_audio to reconfigure.' % (name, hostapi))&amp;#10;    if len(m) &gt; 1:&amp;#10;        raise RuntimeError('Device name is ambiguous: &quot;%s&quot; [%s]' % (name, hostapi))&amp;#10;    return m[0][0]&amp;#10;&amp;#10;&amp;#10;def vlt_make_config():&amp;#10;    devs = vlt_output_devices()&amp;#10;    if not devs:&amp;#10;        raise RuntimeError('No audio output devices found.')&amp;#10;    labels = ['%s [%s] (%d ch)' % (d[1], d[2], d[3]) for d in devs]&amp;#10;    dlg = gui.Dlg(title='Audio routing')&amp;#10;    dlg.addField('NOISE  (calibrated: babble, VLT noise):', choices=labels)&amp;#10;    dlg.addField('SPEAKER  (uncalibrated: spoken instructions):', choices=labels)&amp;#10;    dlg.addField('SYNC  (tone to the recorder):', choices=[VLT_SYNC_NONE] + labels)&amp;#10;    ans = dlg.show()&amp;#10;    if not dlg.OK:&amp;#10;        core.quit()&amp;#10;&amp;#10;    def pick(lbl):&amp;#10;        d = devs[labels.index(lbl)]&amp;#10;        return {'name': d[1], 'hostapi': d[2]}&amp;#10;&amp;#10;    cfg = {'created': time.strftime('%Y-%m-%dT%H:%M:%S'),&amp;#10;           'devices': {'noise': pick(ans[0]),&amp;#10;                       'speaker': pick(ans[1]),&amp;#10;                       'sync': None if ans[2] == VLT_SYNC_NONE else pick(ans[2])},&amp;#10;           'sync_tone': {'f0_hz': 500.0, 'f1_hz': 4000.0,&amp;#10;                         'duration_s': 0.1, 'amplitude': 0.7}}&amp;#10;    with open('vlt_config.json', 'w') as f:&amp;#10;        json.dump(cfg, f, indent=2)&amp;#10;    return cfg&amp;#10;&amp;#10;&amp;#10;def vdc_load_pages(path):&amp;#10;    &quot;&quot;&quot;Blank line ends a page. Lines within a page are joined, so hard&amp;#10;    wrapping in the source file does not affect the display.&quot;&quot;&quot;&amp;#10;    pages, buf = [], []&amp;#10;    with open(path, encoding='utf-8-sig') as f:&amp;#10;        for raw in f:&amp;#10;            line = raw.strip()&amp;#10;            if line.startswith('#'):&amp;#10;                continue&amp;#10;            if not line:&amp;#10;                if buf:&amp;#10;                    pages.append(' '.join(buf))&amp;#10;                    buf = []&amp;#10;            else:&amp;#10;                buf.append(line)&amp;#10;    if buf:&amp;#10;        pages.append(' '.join(buf))&amp;#10;    if not pages:&amp;#10;        raise RuntimeError('No pages found in ' + path)&amp;#10;    return pages&amp;#10;&amp;#10;&amp;#10;if os.path.exists('vlt_config.json'):&amp;#10;    with open('vlt_config.json') as _f:&amp;#10;        vlt_cfg = json.load(_f)&amp;#10;else:&amp;#10;    vlt_cfg = vlt_make_config()&amp;#10;&amp;#10;vdc_pages = vdc_load_pages('PsychoPy/vdc_passage.txt')&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="global vlt_cfg&amp;#10;&amp;#10;#fs = 44100&amp;#10;#times = np.linspace(0, 0.1, fs, endpoint=True)&amp;#10;#beep = 0.7*np.sin(2 * np.pi * 440 * times)&amp;#10;&amp;#10;today = date.today()&amp;#10;filename = _thisDir + os.sep + u'data/%s_%s_%s' % (expName, expInfo['participant'],today.strftime('%Y-%m-%d'))&amp;#10;wavfilename = _thisDir + os.sep + u'data/%s_%s_%s' % (expName, expInfo['participant'],today.strftime('%Y-%m-%d'))+ os.sep + u'data/%s_%s' % (expName, expInfo['participant'])&amp;#10;&amp;#10;record_TF = str(expInfo['record']).lower() in ('true', '1', 'yes')&amp;#10;if not record_TF:&amp;#10;    CT_opac = 1&amp;#10;&amp;#10;timeStart = time.time();&amp;#10;#readable_time = time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(timeStart))&amp;#10;&amp;#10;# Construct the file path&amp;#10;file_path = filename + &quot;_segtimes.csv&quot;&amp;#10;ver_path = filename + &quot;_ver.csv&quot;&amp;#10;&amp;#10;# Check if the file exists&amp;#10;if not os.path.exists(file_path):&amp;#10;    with open(filename+'_segtimes.csv', mode='w', newline='') as file:&amp;#10;        writer = csv.writer(file)&amp;#10;        writer.writerow(['Trial', 'T1', 'T2'])&amp;#10;&amp;#10;# Check if the file exists&amp;#10;if not os.path.exists(ver_path):&amp;#10;    with open(filename+'_Ratings.csv', mode='w', newline='') as file:&amp;#10;        writer = csv.writer(file)&amp;#10;        writer.writerow(['Trial', 'Rating'])&amp;#10;&amp;#10;# syncDev = 'Speakers (Cable Creation), Windows DirectSound'&amp;#10;&amp;#10;# reset_audio lives in expInfo, which does not exist in Before Experiment,&amp;#10;# so the re-run happens here -- the dialog renders over the window. Setup&amp;#10;# only, not something to tick mid-study.&amp;#10;if str(expInfo.get('reset_audio', False)).lower() in ('true', '1', 'yes'):&amp;#10;    vlt_cfg = vlt_make_config()&amp;#10;&amp;#10;vlt_skip_sync = (str(expInfo.get('skip_sync', False)).lower() in ('true', '1', 'yes') or vlt_cfg['devices'].get('sync') is None)&amp;#10;&amp;#10;_dn = vlt_cfg['devices']&amp;#10;noiseDev   = vlt_find_device(_dn['noise']['name'],   _dn['noise']['hostapi'])&amp;#10;speakerDev = vlt_find_device(_dn['speaker']['name'], _dn['speaker']['hostapi'])&amp;#10;syncDev    = (None if vlt_skip_sync else&amp;#10;              vlt_find_device(_dn['sync']['name'], _dn['sync']['hostapi']))&amp;#10;if vlt_skip_sync:&amp;#10;    print('*** SYNC OFF -- no tones will be recorded ***')&amp;#10;&amp;#10;# sync tone: 100 ms linear sweep 500 -&gt; 4000 Hz, 5 ms cosine edges&amp;#10;_st = vlt_cfg['sync_tone']&amp;#10;sync_fs = 44100&amp;#10;_n = int(round(sync_fs * _st['duration_s']))&amp;#10;_t = np.arange(_n) / float(sync_fs)&amp;#10;_k = (_st['f1_hz'] - _st['f0_hz']) / _st['duration_s']&amp;#10;_w = np.ones(_n)&amp;#10;_e = max(1, int(sync_fs * 0.005))&amp;#10;_w[:_e] = np.linspace(0, 1, _e)&amp;#10;_w[-_e:] = np.linspace(1, 0, _e)&amp;#10;sync_chirp = (_st['amplitude'] * np.sin(2 * np.pi * (_st['f0_hz'] * _t + 0.5 * _k * _t * _t)) * _w).astype('float32')&amp;#10;&amp;#10;&amp;#10;def sync_tone():&amp;#10;    &quot;&quot;&quot;Fire the sync tone and block until it finishes, so the next sd.play()&amp;#10;    cannot cut it short. Returns its time on the segtimes clock, or ''.&quot;&quot;&quot;&amp;#10;    if syncDev is None:&amp;#10;        return ''&amp;#10;    _tt = time.time() - timeStart&amp;#10;    sd.play(sync_chirp, samplerate=sync_fs, device=syncDev)&amp;#10;    sd.wait()&amp;#10;    return _tt&amp;#10;&amp;#10;&amp;#10;def sync_seg(name, t1, t2):&amp;#10;    &quot;&quot;&quot;Append a row to _segtimes.csv in your existing [Trial, T1, T2] format.&quot;&quot;&quot;&amp;#10;    with open(filename + '_segtimes.csv', mode='r') as f:&amp;#10;        rows = [r for r in csv.reader(f)]&amp;#10;    rows.append([name, t1, t2])&amp;#10;    with open(filename + '_segtimes.csv', mode='w', newline='') as f:&amp;#10;        csv.writer(f).writerows(rows)&amp;#10;&amp;#10;&amp;#10;# noise ladder, pre-loaded so no trial pays disk I/O at onset&amp;#10;vdc_buffers = {}&amp;#10;for _fn in sorted(os.listdir('VDC_NOISE')):&amp;#10;    if _fn.lower().endswith('.wav'):&amp;#10;        _d, _sr = sf.read(os.path.join('VDC_NOISE', _fn), dtype='float32', always_2d=True)&amp;#10;        vdc_buffers[_fn] = (_d, _sr)&amp;#10;&amp;#10;vdc_idx = 0     # read position through vdc_pages&amp;#10;block = 0       # VDC block counter -&gt; B1, B2, B3 ..." valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="with open(filename+'_segtimes.csv', mode='r') as file:&amp;#10;    reader = csv.reader(file)&amp;#10;    segData = [row for row in reader]&amp;#10;timeStart = time.time();&amp;#10;&amp;#10;#sd.play(beep, samplerate=fs, device=syncDev)&amp;#10;sync_seg('Beep', sync_tone(), 0)&amp;#10;&amp;#10;# Save the modified data back to the CSV file&amp;#10;with open(filename+'_segtimes.csv', mode='w', newline='') as file:&amp;#10;    writer = csv.writer(file)&amp;#10;    writer.writerows(segData)&amp;#10;&amp;#10;time.sleep(1.0)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_ready" valType="code" updates="None" name="name"/>
      </CodeComponent>
