      <CodeComponent name="code_vdc" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="VDC_READ_DUR = 15.0&amp;#10;VDC_LEAD_IN  = 0.5&amp;#10;VDC_RESET_TEXT_EACH_BLOCK = True" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="VDC_READ_DUR = 15.0;&amp;#10;VDC_LEAD_IN = 0.5;&amp;#10;VDC_RESET_TEXT_EACH_BLOCK = true;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="vdc_tone_t = sync_tone();&amp;#10;[_d, _sr] = vdc_buffers[stim_file];&amp;#10;sd.play(_d, {&quot;samplerate&quot;: _sr, &quot;device&quot;: noiseDev, &quot;loop&quot;: true});&amp;#10;vdc_t1 = (time.time() - timeStart);&amp;#10;vdc_read_start = null;&amp;#10;vdc_page_start = vdc_idx;&amp;#10;vdc_page_times = [];&amp;#10;vdc_last_turn = vdc_t1;&amp;#10;vdc_prev_down = true;&amp;#10;delete _VDC_key_allKeys.slice(0);&amp;#10;VDC_text.setText(vdc_pages[vdc_idx]);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# loop variables from vdc_conditions.xlsx: trial, level_dBA, stim_file&amp;#10;&amp;#10;# Tone first. It blocks ~100 ms and stops whatever was playing, which is&amp;#10;# exactly what we want here -- the old level is being replaced anyway. This&amp;#10;# runs before the routine's frame loop, so it costs nothing against t=0.&amp;#10;vdc_tone_t = sync_tone()&amp;#10;&amp;#10;_d, _sr = vdc_buffers[stim_file]&amp;#10;sd.play(_d, samplerate=_sr, device=noiseDev, loop=True)&amp;#10;&amp;#10;vdc_t1 = time.time() - timeStart      # babble onset&amp;#10;vdc_read_start = None                 # captured on the frame text appears&amp;#10;vdc_page_start = vdc_idx&amp;#10;vdc_page_times = []&amp;#10;vdc_last_turn = vdc_t1&amp;#10;vdc_prev_down = True                  # swallow a click held over&amp;#10;del _VDC_key_allKeys[:]&amp;#10;VDC_text.setText(vdc_pages[vdc_idx])" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if len(_VDC_quit_allKeys) &gt; 0:&amp;#10;    del _VDC_quit_allKeys[:]&amp;#10;    currentLoop.finished = True&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;if t &gt;= VDC_LEAD_IN + VDC_READ_DUR:&amp;#10;    continueRoutine = False&amp;#10;elif t &gt;= VDC_LEAD_IN:&amp;#10;    if vdc_read_start is None:&amp;#10;        vdc_read_start = time.time() - timeStart&amp;#10;        vdc_last_turn = vdc_read_start&amp;#10;    _down = VDC_next.isClicked&amp;#10;    _turn = (_down and not vdc_prev_down) or len(_VDC_key_allKeys) &gt; 0&amp;#10;    vdc_prev_down = _down&amp;#10;    if _turn:&amp;#10;        #del _VDC_key_allKeys[:]&amp;#10;        _now = time.time() - timeStart&amp;#10;        vdc_page_times.append((vdc_idx, round(_now - vdc_last_turn, 3)))&amp;#10;        vdc_last_turn = _now&amp;#10;        vdc_idx += 1&amp;#10;        if vdc_idx &gt;= len(vdc_pages):&amp;#10;            vdc_idx = 0&amp;#10;        VDC_text.setText(vdc_pages[vdc_idx])" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((_VDC_quit_allKeys.length &gt; 0)) {&amp;#10;    delete _VDC_quit_allKeys.slice(0);&amp;#10;    currentLoop.finished = true;&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;if ((t &gt;= (VDC_LEAD_IN + VDC_READ_DUR))) {&amp;#10;    continueRoutine = false;&amp;#10;} else {&amp;#10;    if ((t &gt;= VDC_LEAD_IN)) {&amp;#10;        if ((vdc_read_start === null)) {&amp;#10;            vdc_read_start = (time.time() - timeStart);&amp;#10;            vdc_last_turn = vdc_read_start;&amp;#10;        }&amp;#10;        _down = VDC_next.isClicked;&amp;#10;        _turn = ((_down &amp;&amp; (! vdc_prev_down)) || (_VDC_key_allKeys.length &gt; 0));&amp;#10;        vdc_prev_down = _down;&amp;#10;        if (_turn) {&amp;#10;            _now = (time.time() - timeStart);&amp;#10;            vdc_page_times.push([vdc_idx, util.round((_now - vdc_last_turn), 3)]);&amp;#10;            vdc_last_turn = _now;&amp;#10;            vdc_idx += 1;&amp;#10;            if ((vdc_idx &gt;= vdc_pages.length)) {&amp;#10;                vdc_idx = 0;&amp;#10;            }&amp;#10;            VDC_text.setText(vdc_pages[vdc_idx]);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="vdc_t2 = (time.time() - timeStart);&amp;#10;vdc_page_times.push([vdc_idx, util.round((vdc_t2 - vdc_last_turn), 3)]);&amp;#10;vdc_idx += 1;&amp;#10;if ((vdc_idx &gt;= vdc_pages.length)) {&amp;#10;    vdc_idx = 0;&amp;#10;}&amp;#10;_tag = `${block}_T${trial}_${Number.parseInt(level_dBA)}`;&amp;#10;sync_seg((&quot;Tone_&quot; + _tag), vdc_tone_t, 0);&amp;#10;sync_seg((&quot;VDC_&quot; + _tag), vdc_read_start, vdc_t2);&amp;#10;psychoJS.experiment.addData(&quot;Task&quot;, &quot;VDC&quot;);&amp;#10;psychoJS.experiment.addData(&quot;VDC.block&quot;, block);&amp;#10;psychoJS.experiment.addData(&quot;VDC.level_dBA&quot;, level_dBA);&amp;#10;psychoJS.experiment.addData(&quot;VDC.stim_file&quot;, stim_file);&amp;#10;psychoJS.experiment.addData(&quot;VDC.page_start&quot;, vdc_page_start);&amp;#10;psychoJS.experiment.addData(&quot;VDC.page_end&quot;, vdc_idx);&amp;#10;psychoJS.experiment.addData(&quot;VDC.pages_turned&quot;, (vdc_page_times.length - 1));&amp;#10;psychoJS.experiment.addData(&quot;VDC.page_durs&quot;, vdc_page_times.toString());&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="vdc_t2 = time.time() - timeStart&amp;#10;vdc_page_times.append((vdc_idx, round(vdc_t2 - vdc_last_turn, 3)))&amp;#10;vdc_idx += 1&amp;#10;if vdc_idx &gt;= len(vdc_pages):&amp;#10;    vdc_idx = 0&amp;#10;&amp;#10;# The babble is deliberately NOT stopped here. It runs through the Borg&amp;#10;# rating and is replaced at the next trial's tone. Cutting it for the rating&amp;#10;# changes the referent of the effort judgement.&amp;#10;&amp;#10;_tag = '%s_T%s_%ddBA' % (block, trial, int(level_dBA))&amp;#10;sync_seg('Tone_' + _tag, vdc_tone_t, 0)&amp;#10;sync_seg('VDC_' + _tag, vdc_read_start, vdc_t2)&amp;#10;&amp;#10;thisExp.addData('Task', 'VDC')&amp;#10;thisExp.addData('VDC.block', block)&amp;#10;thisExp.addData('VDC.level_dBA', level_dBA)&amp;#10;thisExp.addData('VDC.stim_file', stim_file)&amp;#10;thisExp.addData('VDC.page_start', vdc_page_start)&amp;#10;thisExp.addData('VDC.page_end', vdc_idx)&amp;#10;thisExp.addData('VDC.pages_turned', len(vdc_page_times) - 1)&amp;#10;thisExp.addData('VDC.page_durs', str(vdc_page_times))" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_vdc" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <ButtonComponent name="VDC_next" plugin="None">
