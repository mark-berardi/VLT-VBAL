      <CodeComponent name="code_SpeechTask" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="CLR_ON      = (1, 1, 1)&amp;#10;CLR_OFF     = (0.35, 0.35, 0.35)&amp;#10;CLR_RETAKE  = (1, -1, -1)&amp;#10;&amp;#10;TASK_REPS   = {'Speech': 1, 'Vowel': 3};&amp;#10;DEBOUNCE    = 0.3&amp;#10;RETAKE_FLASH = 0.4&amp;#10;&amp;#10;#SpeechMat = ''" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="CLR_ON = [1, 1, 1];&amp;#10;CLR_OFF = [0.35, 0.35, 0.35];&amp;#10;CLR_RETAKE = [1, (- 1), (- 1)];&amp;#10;TASK_REPS = {&quot;Speech&quot;: 1, &quot;Vowel&quot;: 3};&amp;#10;DEBOUNCE = 0.3;&amp;#10;RETAKE_FLASH = 0.4;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="#global SpeechMat&amp;#10;&amp;#10;_lines = [text_SpeechTask_high, text_SpeechTask_mid, text_SpeechTask_low]&amp;#10;&amp;#10;nrep = TASK_REPS.get(Task)&amp;#10;if nrep is None:&amp;#10;    raise ValueError('Unknown Task &quot;%s&quot; -- expected one of %s'&amp;#10;                     % (Task, list(TASK_REPS)))&amp;#10;if not (1 &lt;= Rep &lt;= nrep):&amp;#10;    raise ValueError('Rep %s is out of range for Task &quot;%s&quot; (1..%d)'&amp;#10;                     % (Rep, Task, nrep))&amp;#10;&amp;#10;for _ln in _lines:&amp;#10;    _ln.alignText = 'center'&amp;#10;&amp;#10;if nrep == 1:&amp;#10;    text_SpeechTask_mid.setText(SpeechMat)&amp;#10;    text_SpeechTask_high.setText('')&amp;#10;    text_SpeechTask_low.setText('')&amp;#10;    text_SpeechTask_mid.color = CLR_ON&amp;#10;else:&amp;#10;    for _ln in _lines:&amp;#10;        _ln.setText(SpeechMat)&amp;#10;    for _i, _ln in enumerate(_lines, start=1):&amp;#10;        _ln.color = CLR_ON if _i == Rep else CLR_OFF&amp;#10;&amp;#10;isStop = 0&amp;#10;retake = False&amp;#10;lockUntil = 0&amp;#10;endAt = None&amp;#10;speech_tone_t = sync_tone()&amp;#10;t1 = time.time() - timeStart" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="#mic.poll()&amp;#10;if endAt is not None and t &gt;= endAt:&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;elif t &lt; lockUntil:&amp;#10;    # swallow anything arriving during the lockout, so a held key can't&amp;#10;    # queue up and fire the instant the lockout expires&amp;#10;    del _key_resp_SpeechTask_allKeys[:]&amp;#10;&amp;#10;elif len(_key_resp_SpeechTask_allKeys):&amp;#10;    _names = [k.name for k in _key_resp_SpeechTask_allKeys]&amp;#10;    key_resp_SpeechTask.keys = _names[-1]&amp;#10;    key_resp_SpeechTask.rt = _key_resp_SpeechTask_allKeys[-1].rt&amp;#10;    del _key_resp_SpeechTask_allKeys[:]&amp;#10;    lockUntil = t + DEBOUNCE&amp;#10;&amp;#10;    if 'left' in _names or 'backspace' in _names:&amp;#10;        retake = True&amp;#10;        if nrep == 1:&amp;#10;            text_SpeechTask_mid.color = CLR_RETAKE&amp;#10;        else:&amp;#10;            for _i, _ln in enumerate(_lines, start=1):&amp;#10;                _ln.color = CLR_RETAKE if _i == Rep else CLR_OFF&amp;#10;        endAt = t + RETAKE_FLASH&amp;#10;&amp;#10;    elif isStop == 1:&amp;#10;        retake = False&amp;#10;        continueRoutine = False&amp;#10;&amp;#10;    else:&amp;#10;        retake = False&amp;#10;        #SpeechMat = 'STOP'&amp;#10;        text_SpeechTask_high.setText('')&amp;#10;        text_SpeechTask_low.setText('')&amp;#10;        text_SpeechTask_mid.setText('STOP')&amp;#10;        text_SpeechTask_mid.color = CLR_ON&amp;#10;        isStop = 1" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="t2 = (time.time() - timeStart);&amp;#10;if ((nrep &gt; 1)) {&amp;#10;    trialName = `${WavName}_${Rep}_${prepost}`;&amp;#10;} else {&amp;#10;    trialName = `${WavName}_${prepost}`;&amp;#10;}&amp;#10;attempt = (currentLoop.thisN + 1);&amp;#10;if ((attempt &gt; 1)) {&amp;#10;    trialName = `${trialName}_take${attempt}`;&amp;#10;}&amp;#10;sync_seg((&quot;Tone_&quot; + trialName), speech_tone_t, 0);&amp;#10;sync_seg(trialName, t1, t2);&amp;#10;if ((! retake)) {&amp;#10;    currentLoop.finished = true;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;SpeechTask.trialName&quot;, trialName);&amp;#10;psychoJS.experiment.addData(&quot;SpeechTask.attempt&quot;, attempt);&amp;#10;psychoJS.experiment.addData(&quot;SpeechTask.retake&quot;, retake);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="t2 = time.time() - timeStart&amp;#10;prepost = 'B%d' % block&amp;#10;&amp;#10;if nrep &gt; 1:&amp;#10;    trialName = '%s_%d_%s' % (TaskName, Rep, prepost)&amp;#10;else:&amp;#10;    trialName = '%s_%s' % (TaskName, prepost)&amp;#10;&amp;#10;attempt = currentLoop.thisN + 1&amp;#10;if attempt &gt; 1:&amp;#10;    trialName = '%s_take%d' % (trialName, attempt)&amp;#10;&amp;#10;sync_seg('Tone_' + trialName, speech_tone_t, 0)&amp;#10;sync_seg(trialName, t1, t2)&amp;#10;&amp;#10;if not retake:&amp;#10;    currentLoop.finished = True&amp;#10;&amp;#10;thisExp.addData('SpeechTask.trialName', trialName)&amp;#10;thisExp.addData('SpeechTask.attempt', attempt)&amp;#10;thisExp.addData('SpeechTask.retake', retake)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_SpeechTask" valType="code" updates="None" name="name"/>
      </CodeComponent>
