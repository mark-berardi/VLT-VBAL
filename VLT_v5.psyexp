      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'SpeechIntroText': 'Say &quot;ah&quot; for  about three seconds. Continue until you see STOP. You will do this three times.', 'SpeechMat': 'ah', 'IntroWav': 'vowel_intro_a.wav', 'isIntro': 1, 'Task': 'Vowel', 'Rep': 1, 'TaskName': 'sv_a', 'RatingTF': 0}, {'SpeechIntroText': None, 'SpeechMat': 'ah', 'IntroWav': None, 'isIntro': 0, 'Task': 'Vowel', 'Rep': 2, 'TaskName': 'sv_a', 'RatingTF': 0}, {'SpeechIntroText': None, 'SpeechMat': 'ah', 'IntroWav': None, 'isIntro': 0, 'Task': 'Vowel', 'Rep': 3, 'TaskName': 'sv_a', 'RatingTF': 0}, {'SpeechIntroText': 'Say &quot;ee&quot; for  about three seconds. Continue until you see STOP. You will do this three times.', 'SpeechMat': 'ee', 'IntroWav': 'vowel_intro_i.wav', 'isIntro': 1, 'Task': 'Vowel', 'Rep': 1, 'TaskName': 'sv_i', 'RatingTF': 0}, {'SpeechIntroText': None, 'SpeechMat': 'ee', 'IntroWav': None, 'isIntro': 0, 'Task': 'Vowel', 'Rep': 2, 'TaskName': 'sv_i', 'RatingTF': 0}, {'SpeechIntroText': None, 'SpeechMat': 'ee', 'IntroWav': None, 'isIntro': 0, 'Task': 'Vowel', 'Rep': 3, 'TaskName': 'sv_i', 'RatingTF': 1}, {'SpeechIntroText': 'Say  &quot;ahfah&quot;, &quot;eefee&quot;, or &quot;oofoo&quot; three times in a row, at a comfortable pitch and loudness.', 'SpeechMat': 'ah-fah ah-fah ah-fah', 'IntroWav': 'rff_intro.wav', 'isIntro': 1, 'Task': 'Vowel', 'Rep': 1, 'TaskName': 'rff_a', 'RatingTF': 0}, {'SpeechIntroText': None, 'SpeechMat': 'ee-fee ee-fee ee-fee', 'IntroWav': None, 'isIntro': 0, 'Task': 'Vowel', 'Rep': 2, 'TaskName': 'rff_i', 'RatingTF': 0}, {'SpeechIntroText': None, 'SpeechMat': 'oo-foo oo-foo oo-foo', 'IntroWav': None, 'isIntro': 0, 'Task': 'Vowel', 'Rep': 3, 'TaskName': 'rff_u', 'RatingTF': 1}, {'SpeechIntroText': 'Read each sentence aloud in your normal speaking voice.', 'SpeechMat': 'The blue spot is on the key again.', 'IntroWav': 'capev_intro.wav', 'isIntro': 1, 'Task': 'Speech', 'Rep': 1, 'TaskName': 'capev1', 'RatingTF': 0}, {'SpeechIntroText': None, 'SpeechMat': 'He helped her hurry home.', 'IntroWav': None, 'isIntro': 0, 'Task': 'Speech', 'Rep': 1, 'TaskName': 'capev2', 'RatingTF': 0}, {'SpeechIntroText': None, 'SpeechMat': 'We were away a year ago.', 'IntroWav': None, 'isIntro': 0, 'Task': 'Speech', 'Rep': 1, 'TaskName': 'capev3', 'RatingTF': 0}, {'SpeechIntroText': None, 'SpeechMat': 'I eat eggs every evening.', 'IntroWav': None, 'isIntro': 0, 'Task': 'Speech', 'Rep': 1, 'TaskName': 'capev4', 'RatingTF': 0}, {'SpeechIntroText': None, 'SpeechMat': 'My mama makes lemon jam.', 'IntroWav': None, 'isIntro': 0, 'Task': 'Speech', 'Rep': 1, 'TaskName': 'capev5', 'RatingTF': 0}, {'SpeechIntroText': None, 'SpeechMat': 'Peter will keep at the peak.', 'IntroWav': None, 'isIntro': 0, 'Task': 'Speech', 'Rep': 1, 'TaskName': 'capev6', 'RatingTF': 1}, {'SpeechIntroText': 'Read the passage aloud in your normal speaking voice.', 'SpeechMat': 'When the sunlight strikes raindrops in the air, they act like a prism and form a rainbow. The rainbow is a division of white light into many beautiful colors. These take the shape of a long round arch, with its path high above, and its two ends apparently beyond the horizon. There is, according to legend, a boiling pot of gold at one end. People look but no one ever finds it. When a man looks for something beyond his reach, his friends say he is looking for the pot of gold at the end of the rainbow.', 'IntroWav': 'passage_intro.wav', 'isIntro': 1, 'Task': 'Speech', 'Rep': 1, 'TaskName': 'rainbow', 'RatingTF': 1}]" valType="str"/>
